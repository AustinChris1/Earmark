# Agent wallet (Celo mainnet). Never commit the real .env.
AGENT_PRIVATE_KEY=0x
AGENT_ADDRESS=0x
# Primary RPC. A Chainstack endpoint carries its key in the path, so keep it out of the repo
# and out of anything served to a browser.
# CELO_RPC_URL=https://celo-mainnet.core.chainstack.com/<key>
# CELO_RPC_FALLBACK=https://forno.celo.org
# PUBLIC_RPC_URL=https://forno.celo.org

# Hackathon attribution (from celobuilders.xyz registration) and deployed contract
ATTRIBUTION_TAG=celo_
EARMARK_ADDRESS=0x
ERC8004_AGENT_ID=

# Telegram bot (BotFather) and public HTTPS base URL for the mini app
TELEGRAM_BOT_TOKEN=
PUBLIC_URL=https://example.com
# PORT=3010

# x402 facilitator key from https://x402.celo.org (needed for /settle)
X402_API_KEY=

# Database. Unset means a local libSQL file at DB_PATH; in production point it at Turso,
# because the host filesystem is wiped on every restart.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Self proof of personhood. Unset means the gate is not enforced and drives open freely.
# SELF_SBT_ADDRESS is the soulbound token contract Self auto-deploys for your on-chain flow.
# SELF_SBT_ADDRESS=0x
# SELF_VERIFY_URL=https://...self hosted verification page for the flow

# Optional
# CELOSCAN_API_KEY=
# DB_PATH=./earmark.db

# Gas adapter to pay agent gas in a stablecoin (USDT adapter shown). Leave unset to pay gas in CELO.
# AGENT_FEE_CURRENCY=0x0E2A3e05bc9A16F5292A6170456A710cb89C6f72
